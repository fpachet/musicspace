{
  "name": "musicspace",
  "version": "0.1.0",
  "private": true,
  "description": "A static JavaScript prototype of the MusicSpace constraint-based spatialization interface.",
  "scripts": {
    "check": "eslint .",
    "test": "node --test tests/*.test.js",
    "smoke": "node packages/musicspace-engine/scripts/build.cjs && playwright test",
    "capture:screenshot": "node scripts/capture-readme-screenshot.js",
    "capture:video": "node scripts/capture-demo-videos.js",
    "export:linkedin": "node scripts/export-linkedin-videos.js",
    "serve": "python3 -m http.server 8000",
    "benchmark": "node scripts/benchmark.js",
    "format:check": "prettier --check \"*.js\" \"*.cjs\" \"tests/**/*.js\" \"scripts/*.js\" \"targets/faust/*-adapter.js\" \"examples/*.js\"",
    "format": "prettier --write \"*.js\" \"*.cjs\" \"tests/**/*.js\" \"scripts/*.js\" \"targets/faust/*-adapter.js\" \"examples/*.js\"",
    "benchmark:browser": "node scripts/browser-benchmark.js",
    "example": "node examples/headless.js",
    "benchmark:package": "node packages/musicspace-engine/scripts/build.cjs && node scripts/package-benchmark.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

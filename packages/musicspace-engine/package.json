{
  "name": "@musicspace/engine",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Geometry, constraints, trajectories and dynamics for custom interactive interfaces.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./legacy-patch": {
      "types": "./dist/legacy-patch.d.ts",
      "import": "./dist/legacy-patch.mjs",
      "require": "./dist/legacy-patch.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}

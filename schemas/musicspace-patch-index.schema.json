{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpachet.github.io/musicspace/schemas/musicspace-patch-index.schema.json",
  "title": "MusicSpace Patch Index",
  "type": "object",
  "required": ["version", "patches"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "file"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^[^/]+\\.json$"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

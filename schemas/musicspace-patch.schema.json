{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpachet.github.io/musicspace/schemas/musicspace-patch.schema.json",
  "title": "MusicSpace Patch",
  "type": "object",
  "required": ["version", "name", "listener", "sources"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "$schema": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "listener": {
      "$ref": "#/$defs/pointWithTrace"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/namedPoint" },
          { "$ref": "#/$defs/traceable" }
        ]
      }
    },
    "movingObjects": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/namedPoint" },
          { "$ref": "#/$defs/traceable" },
          {
            "type": "object",
            "properties": {
              "trajectory": { "$ref": "#/$defs/trajectory" }
            }
          }
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "sourceBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceBinding"
      }
    },
    "sourceGenerators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceGenerator"
      }
    },
    "sourceGeneratorMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceGeneratorMapping"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string",
          "description": "For faust-wasm targets, an ES module exporting createFaustNode(context, target) or a default factory."
        },
        "wasm": {
          "type": "string",
          "description": "Compiled Faust WebAssembly artifact passed to the Faust adapter module."
        },
        "json": {
          "type": "string",
          "description": "Faust UI/metadata JSON artifact passed to the Faust adapter module."
        },
        "metadata": {
          "type": "string",
          "description": "Alternative Faust metadata JSON artifact path."
        },
        "dsp": {
          "type": "string",
          "description": "Optional source Faust DSP path for documentation/introspection workflows."
        },
        "parameters": {
          "$ref": "#/$defs/targetParameters"
        },
        "params": {
          "$ref": "#/$defs/targetParameters"
        },
        "defaults": {
          "$ref": "#/$defs/targetParameters"
        }
      }
    },
    "parameterMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "feature", "target", "inputMin", "inputMax", "outputMin", "outputMax"],
        "additionalProperties": true,
        "properties": {
          "source": { "type": "string" },
          "feature": { "type": "string" },
          "target": { "type": "string" },
          "inputMin": { "type": "number" },
          "inputMax": { "type": "number" },
          "outputMin": { "type": "number" },
          "outputMax": { "type": "number" },
          "curve": { "enum": ["linear", "exp"] }
        }
      }
    },
    "midiFile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "url": {
          "type": "string"
        },
        "preferredMode": {
          "enum": ["internal", "external"]
        },
        "trackBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source"],
            "additionalProperties": true,
            "properties": {
              "track": {
                "type": "string"
              },
              "trackIndex": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "$ref": "#/$defs/entityName"
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "program": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "isDrums": {
                "type": "boolean"
              }
            }
          }
        },
        "sequenceData": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "$defs": {
    "number": {
      "type": "number"
    },
    "entityName": {
      "type": "string",
      "minLength": 1
    },
    "targetParameters": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "number" },
              { "$ref": "#/$defs/targetParameterConfig" }
            ]
          }
        },
        {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/targetParameterConfig" },
              {
                "type": "object",
                "anyOf": [
                  { "required": ["path"] },
                  { "required": ["address"] }
                ],
                "properties": {
                  "path": { "type": "string" },
                  "address": { "type": "string" }
                }
              }
            ]
          }
        }
      ]
    },
    "targetParameterConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default": { "type": "number" },
        "init": { "type": "number" },
        "value": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string" },
        "suffix": { "type": "string" },
        "digits": { "type": "integer" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "required": ["source", "type"],
      "additionalProperties": true,
      "properties": {
        "source": { "$ref": "#/$defs/entityName" },
        "type": { "const": "audio-file" },
        "name": { "type": "string" },
        "mimeType": { "type": "string" },
        "dataUrl": {
          "type": "string",
          "description": "Embedded user-loaded audio file as a data URL."
        },
        "url": {
          "type": "string",
          "description": "Project-local or remote audio file URL for authored patches."
        },
        "loop": { "type": "boolean" },
        "gain": {
          "type": "number",
          "minimum": 0
        },
        "muted": {
          "type": "boolean"
        },
        "spatialization": {
          "enum": ["pan-distance", "stereo-pan"]
        }
      },
      "anyOf": [
        { "required": ["dataUrl"] },
        { "required": ["url"] }
      ]
    },
    "traceable": {
      "type": "object",
      "properties": {
        "drawTrace": { "type": "boolean" }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/number" },
        "y": { "$ref": "#/$defs/number" }
      }
    },
    "pointWithTrace": {
      "allOf": [
        { "$ref": "#/$defs/point" },
        { "$ref": "#/$defs/traceable" }
      ]
    },
    "namedPoint": {
      "allOf": [
        { "$ref": "#/$defs/point" },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/$defs/entityName" }
          }
        }
      ]
    },
    "constraintNode": {
      "allOf": [
        { "$ref": "#/$defs/pointWithTrace" },
        {
          "type": "object",
          "properties": {
            "isManual": { "type": "boolean" }
          }
        }
      ]
    },
    "trajectory": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": ["rotator", "rotation", "shuttle", "bounce"]
        }
      }
    },
    "sourceGenerator": {
      "oneOf": [
        { "$ref": "#/$defs/midiOstinatoGenerator" },
        { "$ref": "#/$defs/additiveSynthGenerator" }
      ]
    },
    "sourceGeneratorBase": {
      "type": "object",
      "required": ["source", "type"],
      "additionalProperties": true,
      "properties": {
        "source": {
          "$ref": "#/$defs/entityName"
        },
        "type": {
          "type": "string"
        },
        "muted": {
          "type": "boolean"
        },
        "spatialization": {
          "enum": ["pan-distance", "stereo-pan"]
        }
      }
    },
    "midiOstinatoGenerator": {
      "allOf": [
        { "$ref": "#/$defs/sourceGeneratorBase" },
        {
          "type": "object",
          "required": ["source", "type", "pitch", "periodMs", "durationMs", "velocity", "channel"],
          "properties": {
            "type": {
              "const": "midi-ostinato"
            },
            "pitch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "periodMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "durationMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "velocity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            },
            "channel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "waveform": {
              "enum": ["sine", "triangle", "sawtooth", "square"]
            },
            "outputMode": {
              "enum": ["internal", "external"]
            },
            "outputId": {
              "type": "string"
            },
            "outputName": {
              "type": "string"
            }
          }
        }
      ]
    },
    "additiveSynthGenerator": {
      "allOf": [
        { "$ref": "#/$defs/sourceGeneratorBase" },
        {
          "type": "object",
          "required": ["source", "type", "frequencyHz", "gain", "partials"],
          "properties": {
            "type": {
              "const": "additive-synth"
            },
            "frequencyHz": {
              "type": "number",
              "minimum": 20,
              "maximum": 16000
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "attackMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "releaseMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "partials": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/additivePartial"
              }
            }
          }
        }
      ]
    },
    "additivePartial": {
      "type": "object",
      "additionalProperties": true,
      "required": ["amplitude"],
      "properties": {
        "ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frequencyRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frequencyHz": {
          "type": "number",
          "minimum": 20,
          "maximum": 16000
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detuneCents": {
          "type": "number"
        },
        "amplitudeLfoHz": {
          "type": "number",
          "minimum": 0
        },
        "amplitudeLfoDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detuneLfoHz": {
          "type": "number",
          "minimum": 0
        },
        "detuneLfoCents": {
          "type": "number",
          "minimum": 0
        },
        "swellHz": {
          "type": "number",
          "minimum": 0
        },
        "swellDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "swellShape": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lfoPhase": {
          "type": "number"
        }
      },
      "anyOf": [
        { "required": ["ratio"] },
        { "required": ["frequencyRatio"] },
        { "required": ["frequencyHz"] }
      ]
    },
    "sourceGeneratorMapping": {
      "type": "object",
      "required": ["source", "feature", "parameter", "inputMin", "inputMax", "outputMin", "outputMax"],
      "additionalProperties": true,
      "properties": {
        "source": { "$ref": "#/$defs/entityName" },
        "feature": { "enum": ["x", "y", "angle", "distance"] },
        "parameter": { "enum": ["pitch", "periodMs", "durationMs", "velocity", "channel", "frequencyHz", "gain"] },
        "inputMin": { "type": "number" },
        "inputMax": { "type": "number" },
        "outputMin": { "type": "number" },
        "outputMax": { "type": "number" },
        "curve": { "enum": ["linear", "exp"] }
      }
    },
    "constraintBase": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "node": { "$ref": "#/$defs/constraintNode" }
      }
    },
    "constraint": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "sources"],
              "properties": {
                "type": { "const": "angle" },
                "sources": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "$ref": "#/$defs/entityName" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "sources"],
              "properties": {
                "type": { "enum": ["sum", "product"] },
                "sources": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "$ref": "#/$defs/entityName" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "source", "minDistance", "maxDistance"],
              "properties": {
                "type": { "const": "radialLimit" },
                "source": { "$ref": "#/$defs/entityName" },
                "minDistance": { "$ref": "#/$defs/number" },
                "maxDistance": { "$ref": "#/$defs/number" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "anchor", "target", "distance"],
              "properties": {
                "type": { "const": "fixedDistance" },
                "anchor": { "$ref": "#/$defs/entityName" },
                "target": { "$ref": "#/$defs/entityName" },
                "distance": { "$ref": "#/$defs/number" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "sources", "ratio"],
              "properties": {
                "type": { "const": "distanceRatio" },
                "sources": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "$ref": "#/$defs/entityName" }
                },
                "ratio": { "$ref": "#/$defs/number" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "target", "x", "y"],
              "properties": {
                "type": { "const": "pin" },
                "target": { "$ref": "#/$defs/entityName" },
                "x": { "$ref": "#/$defs/number" },
                "y": { "$ref": "#/$defs/number" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "carrier", "attached"],
              "properties": {
                "type": { "const": "solid" },
                "carrier": { "$ref": "#/$defs/entityName" },
                "attached": { "$ref": "#/$defs/entityName" },
                "offsetX": { "$ref": "#/$defs/number" },
                "offsetY": { "$ref": "#/$defs/number" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "sources", "minDistance"],
              "properties": {
                "type": { "const": "separation" },
                "sources": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "$ref": "#/$defs/entityName" }
                },
                "minDistance": { "$ref": "#/$defs/number" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/constraintBase" },
            {
              "type": "object",
              "required": ["type", "source", "centerAngle", "width"],
              "properties": {
                "type": { "const": "angleSector" },
                "source": { "$ref": "#/$defs/entityName" },
                "centerAngle": { "$ref": "#/$defs/number" },
                "width": { "$ref": "#/$defs/number" }
              }
            }
          ]
        }
      ]
    }
  }
}

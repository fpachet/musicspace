      {
        "track": "Drums",
        "source": "Drums",
        "channel": 10,
        "program": 1,
        "isDrums": true
      },
      {
        "track": "Piano",
        "source": "Piano",
        "channel": 3,
        "program": 1
      }
    ]
  },
  "version": 1

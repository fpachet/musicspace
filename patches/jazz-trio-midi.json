{
  "$schema": "../schemas/musicspace-patch.schema.json",
  "key": "jazz-trio-midi",
  "name": "Jazz Trio MIDI Spatializer",
  "listener": {
    "x": 400,
    "y": 300
  },
  "sources": [
    {
      "name": "Bass",
      "x": 245,
      "y": 355
    },
    {
      "name": "Drums",
      "x": 400,
      "y": 170
    },
    {
      "name": "Piano",
      "x": 560,
      "y": 355
    }
